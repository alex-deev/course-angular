{
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "angular-schematics.schematicsDefaultOptions": {
    "angular-*": {
      "skipStyle": true,
    },
    "angular-component": {
      "skipChangeDetectionOnPush": true,
    },
    "angular-page": {
      "skipChangeDetectionOnPush": true
    }
  }
}
